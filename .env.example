LLM_PROVIDER=ollama
LLM_HOST=http://localhost:11434
LLM_MODEL=qwen3:4b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180
MAX_CONTEXT_TOKENS=12000
STRICT_FACTUAL_MODE=true

# Anthropic / Claude (recommended for best quality). Set LLM_PROVIDER=anthropic.
# Needs a pay-as-you-go API key from https://console.anthropic.com
# (a Claude Pro subscription does not include API access).
# NOTE: sends resume/JD text to Anthropic (see ARCHITECTURE.md).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Groq (https://console.groq.com) — free, fast cloud inference.
# Set LLM_PROVIDER=groq above to use this instead of local Ollama.
# NOTE: enabling this sends resume/JD text to Groq's servers (see
# ARCHITECTURE.md "Security & Privacy Constraints").
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Connect over IPv4 only (default true). Avoids ~150 s stalls where IPv6 is broken.
# GROQ_FORCE_IPV4=true
